# Live-Protokoll – Konfiguration für den Server-Betrieb und `uv run`.
# Kopieren nach .env und mindestens einen Anbieter eintragen. Die
# Desktop-Fassung braucht diese Datei nicht: Dort stehen die Schlüssel in den
# Einstellungen (Zahnrad).

# --- Anbieter ----------------------------------------------------------
# Einer der beiden genügt.
#
# Mistral (empfohlen, Verarbeitung in der EU): Damit geht alles – Voxtral und
# Voxtral Realtime, Sprecher unterscheiden, Glossar bei der Erkennung
# (context_bias), Live-Protokoll und Zusammenfassung. Training mit API-Daten
# im Mistral-Konto abschalten (Admin > Privacy).
MISTRAL_API_KEY=

# OpenAI-kompatibel: jeder Dienst mit /v1/chat/completions, optional
# /v1/audio/transcriptions. Damit geht alles außer dem, was nur Mistral kann
# (Echtzeit, Sprecher, Glossar bei der Erkennung).
#
# Die Vorlage füllt Adresse und Modelle vor; jedes Feld darunter überschreibt
# sie. Vorlagen: mistral, openrouter, openai, ollama, custom.
#   openrouter – Anfragen gehen meist an Server in den USA. Die Anwendung
#                fordert je Anfrage Anbieter ohne Speicherung und Training an.
#   openai     – Server in den USA. Die Vorlage nennt keine Modelle, sie
#                müssen aus der Modellübersicht von OpenAI eingetragen werden.
#   ollama     – läuft im eigenen Netz, kein Schlüssel nötig. Im Container
#                ist der Rechner selbst http://host.docker.internal:11434.
# Ohne Vorlage wird sie aus der Adresse erraten. Ein "/v1" am Ende der
# Adresse ist egal.
# OPENAI_COMPAT_PRESET=openrouter
# OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_LIVE_MODEL=google/gemma-4-26b-a4b-it
# OPENAI_COMPAT_SUMMARY_MODEL=z-ai/glm-5.3
# Leer lassen, wenn der Dienst nicht transkribiert:
# OPENAI_COMPAT_TRANSCRIPTION_MODEL=openai/whisper-large-v3-turbo

# Veraltet: OPENROUTER_API_KEY gilt weiter als OpenAI-kompatibler Anbieter
# mit der Vorlage openrouter, solange OPENAI_COMPAT_* leer ist. Bitte auf
# OPENAI_COMPAT_PRESET=openrouter und OPENAI_COMPAT_API_KEY umstellen.
# OPENROUTER_API_KEY=

# --- Lokale Transkription ----------------------------------------------
# Adresse eines whisper.cpp-Servers (whisper-server). Am eigenen Rechner ist
# ohne Angabe http://127.0.0.1:8081 gemeint. Auf dem Server erscheint die
# lokale Transkription nur, wenn diese Adresse gesetzt ist – mit dem
# Compose-Profil "whisper" etwa http://whisper:8081. Ohne GPU läuft
# large-v3-turbo auf einem Server oft nicht in Echtzeit.
# WHISPER_URL=

# Begriffsliste für die Erkennung: Eigennamen, Fachbegriffe und Abkürzungen,
# die sonst falsch geschrieben würden. Sie geht als Hinweis an den Dienst –
# bei Whisper als Prompt, bei Voxtral als context_bias (dort je Eintrag ein
# Wort) – und beeinflusst nur die Schreibweise, nicht den Inhalt.
# Kommagetrennt. Nur Desktop – auf dem Server pflegt jeder Nutzer seine
# eigene Liste in den Einstellungen.
VOCABULARY=

# --- Eigene Auswahllisten (Sonderfälle) --------------------------------
# Ohne diese Angaben entstehen Transkription, Live-Protokoll und
# Zusammenfassung aus den Anbietern oben. Wer mehr will – mehrere Anbieter
# nebeneinander, eigene Beschriftung, gesperrte Einträge je Gruppe –, gibt
# die Listen als JSON vor; sie ersetzen dann die gebildeten ganz.
#
# `type` unterscheidet den API-Dialekt, nicht den Ort: whisper-cpp
# (/inference), openai-compatible, mistral (Voxtral als Datei, mit Sprechern
# und context_bias), mistral-realtime (stehende WebSocket-Verbindung).
# key_ref sagt, welcher Schlüssel für einen Eintrag ohne eigenen gilt
# ("mistral" oder "openai"). local steuert den Datenschutz-Hinweis, privacy
# und cost stehen so in der Auswahl. price_hour bzw. price_in/price_out
# (US-Dollar je Stunde bzw. je Million Tokens) speisen die
# Verbrauchsübersicht. restricted: true siehe AUTH_PROXY.
#
# TRANSCRIPTION_ENGINES=[{"id":"voxtral-realtime","name":"Voxtral Realtime (Mistral, Cloud)","type":"mistral-realtime","url":"https://api.eu.mistral.ai","model":"voxtral-mini-transcribe-realtime-2602","local":false,"cost":"~33 ct je Stunde, sofort"},{"id":"voxtral","name":"Voxtral (Mistral, Cloud)","type":"mistral","url":"https://api.eu.mistral.ai","model":"voxtral-mini-latest","local":false}]
#
# Live-Protokoll: priorisierte Liste, "Automatisch" nimmt den ersten
# erreichbaren. `extra` geht mit jeder Anfrage mit, etwa reasoning_effort.
# Welche Modelle ein Schlüssel nutzen darf, hängt vom Tarif beim Anbieter ab.
# LLM_ENDPOINTS=[{"name":"mistral","label":"Mistral Nemo · EU","type":"mistral","url":"https://api.eu.mistral.ai","model":"open-mistral-nemo","local":false}]
#
# Zusammenfassung: genau diese Modelle stehen nach dem Stopp zur Wahl.
# SUMMARY_MODELS=[{"id":"eu","name":"GLM 5.3","label":"Gründlich & EU","speed":"15–30 s","endpoint":{"name":"glm-5.3 (Mistral EU)","type":"mistral","url":"https://api.eu.mistral.ai","model":"zai-glm-5-3","local":false,"key_ref":"mistral","extra":{"reasoning_effort":"high"}}}]

# --- Betriebsmodus -----------------------------------------------------
# desktop: läuft auf dem eigenen Rechner, Schlüssel in den Einstellungen,
#          Sitzungen zusätzlich auf der Platte.
# hosted:  läuft auf einem Server, Schlüssel aus dieser Datei, Sitzungen nur
#          im Arbeitsspeicher, dazu "Meine Sitzungen". Im Container gesetzt.
# DEPLOYMENT_MODE=hosted

# Ohne AUTH_PROXY gibt es einen einzigen, impliziten Benutzer: keine
# Anmeldung, keine Verbrauchsgrenze. Wer den Dienst mehreren Leuten öffnet,
# stellt einen Proxy davor, der Remote-User setzt (z. B. Authelia oder
# oauth2-proxy), und schaltet AUTH_PROXY ein. Dann kommt der Benutzer als
# Remote-User, die Gruppen als Remote-Groups. Nur einschalten, wenn der Port
# ausschließlich vom Proxy erreichbar ist – sonst ließe sich die Kopfzeile
# fälschen.
#
# Hinter dem Proxy gibt es: Freigaben über Gruppen (ein Eintrag mit
# "restricted": true in den Listen oben ist nur für die Gruppe lp-<id>
# sichtbar, bei LLM_ENDPOINTS lp-<name>; lp-alle schaltet alles frei), eine
# Monatsgrenze je Benutzer (USAGE_LIMIT_USD, eigene Grenze über die Gruppe
# lp-limit-<betrag>), das Verbrauchsprotokoll und für die Gruppe admins die
# Verbrauchsübersicht.
# AUTH_PROXY=true
# USAGE_LIMIT_USD=0

# Grenzen im Server-Betrieb. MAX_SESSION_MINUTES gilt immer und zählt
# aufgenommenes Audio, nicht die Wanduhr. MAX_SESSIONS_PER_USER begrenzt
# gleichzeitige Aufnahmen je Benutzer nur mit AUTH_PROXY; der implizite
# Benutzer hat keine Höchstzahl.
# MAX_SESSION_MINUTES=180
# MAX_SESSIONS_PER_USER=2
# Größte hochgeladene Datei in MB (liegt beim Verarbeiten im Arbeitsspeicher).
# MAX_UPLOAD_MB=150

# Lebensdauer von Sitzungen (beide Betriebsarten): Eine beendete Sitzung
# fliegt nach so vielen Minuten ohne Zugriff aus dem Speicher. Reißt die
# Verbindung ohne Stopp ab, wartet die Sitzung so viele Sekunden auf eine
# neue und beendet sich dann selbst.
# SESSION_TTL_MINUTES=30
# ORPHAN_GRACE_SECONDS=120

# Ziel des Hinweises auf die lokale Fassung und des Links in der Fußzeile.
# Vorgabe: die Releases dieses Projekts auf GitHub.
# DOWNLOAD_URL=https://github.com/nicohofdtz/live-protocol/releases

# --- Update-Prüfung (nur Desktop) --------------------------------------
# Fragt beim Start die GitHub-API nach dem neuesten Release, im Backend und
# folgenlos, wenn nichts erreichbar ist. false schaltet sie ab.
# UPDATE_CHECK=true
# Andere Quelle: gleiche Form wie die GitHub-API (tag_name, html_url) oder
# {"version": "...", "download_url": "..."}.
# UPDATE_URL=https://api.github.com/repos/nicohofdtz/live-protocol/releases/latest

# --- Eigene Inhalte der Instanz ----------------------------------------
# Verzeichnis mit Impressum, Datenschutz, Hinweisleiste, Logo …, siehe
# docs/overlay.md. Im Container z. B. /overlay.
# OVERLAY_DIR=
# Hinweisleiste oben als Klartext (eine banner.html im Overlay geht vor).
# BANNER_TEXT=
# Vor jeder Aufnahme fragen, ob alle Anwesenden einverstanden sind.
# CONSENT_HINT=true

# --- Ablauf ------------------------------------------------------------
# Fortschreibung auslösen nach Zeit ODER neuen Zeichen (was zuerst eintritt).
# TRIGGER_SECONDS=90
# TRIGGER_CHARS=1200

# Segmentgrenzen für die gestückelte Transkription (Schnitt an der leisesten
# Stelle darin). Für mistral-realtime ohne Bedeutung – dort schneidet der
# Dienst. SEGMENT_MAX_SECONDS nie über 29 setzen: Whisper arbeitet immer mit
# einem 30-Sekunden-Fenster, alles darüber öffnet ein zweites, fast leeres.
# SEGMENT_MIN_SECONDS=10
# SEGMENT_MAX_SECONDS=29

# --- Ablage --------------------------------------------------------------
# Vorgabe ist ~/.local/share/live-protocol/<name>; das Container-Abbild
# setzt alle drei auf /data/<name>, dort hängt compose.yaml ein Volume ein.
# Verbrauch je Benutzer (nur mit AUTH_PROXY): eine Zeile je bezahltem
# Aufruf, keine Inhalte, Kosten geschätzt aus den Listenpreisen.
# USAGE_DIR=/data/usage
# Gespeicherte Sitzungen (nur Server): im Browser mit dem Tresor-Passwort
# verschlüsselt, hier liegt nur Chiffrat. Grenze je Nutzer in MB.
# VAULT_DIR=/data/vault
# VAULT_QUOTA_MB=1000
# Einstellungen je Benutzer (nicht Sitzungsinhalte).
# USER_PREFS_DIR=/data/prefs
